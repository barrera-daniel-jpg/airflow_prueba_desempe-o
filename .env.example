# --- METADATA AIRFLOW POSTGRES ---
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=
AIRFLOW_DB_PORT=

# --- DATA WAREHOUSE POSTGRES (DESTINO) ---
DW_POSTGRES_USER=
DW_POSTGRES_PASSWORD=
DW_POSTGRES_DB=
DW_POSTGRES_PORT=

# --- AIRFLOW CONFIG ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=

# --- AUTOMATIC AIRFLOW CONNECTIONS ---
# Connection ID: postgres_dw
AIRFLOW_CONN_POSTGRES_DW=postgresql://[DW_POSTGRES_USER]:[DW_POSTGRES_PASSWORD]@postgres-dw:[AIRFLOW_DB_PORT]/datamart_dw

# --- AUTOMATIC AIRFLOW VARIABLES ---
AIRFLOW_VAR_RAW_DATA_PATH=/opt/airflow/data/raw
AIRFLOW_VAR_API_PRODUCT_URL=http://catalog-api:8000/api/v1/products
AIRFLOW_VAR_RETENTION_DAYS=365